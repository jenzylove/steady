# Solana mainnet reads (required for everything)
HELIUS_API_KEY=

# Telegraph purchases: an EVM key holding Base Sepolia test USDC (x402). Also signs evaluation uploads.
TELEGRAPH_PAYER_KEY=
TELEGRAPH_DAILY_CAP_USD=5          # resets 00:00 UTC; each answer is capped at $0.05
# TELEGRAPH_NODE=https://devnode.telegraphprotocol.com

# Signs every memo (EIP-191). Any EVM private key; its address is shown by POST /verify.
MEMO_SIGNER_KEY=

# Which service this process runs: api, bot or miner (default miner)
STEADY_SERVICE=api

# API limits
FREE_RUNS_PER_DAY=20               # per client IP, covers /advise, /fix and /presign
HEAVY_CALLS_PER_MIN=30             # global ceiling
# ALLOWED_ORIGINS=https://steady.jdollar.site

# Forward ledger: frontier control model (either key works)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LEDGER_PATH=data/ledger.jsonl

# Telegram bot
TELEGRAM_BOT_TOKEN=
WATCH_INTERVAL_MIN=15
